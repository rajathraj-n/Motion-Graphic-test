{
  "name": "chatgpt-beyond-possibilities",
  "version": "1.0.0",
  "private": true,
  "description": "40-second cinematic SaaS promo built with Remotion (3840x2160 @ 60fps)",
  "scripts": {
    "dev": "remotion studio",
    "music": "node scripts/generate-soundtrack.mjs",
    "render": "remotion render BeyondPossibilities out/beyond-possibilities-4k.mp4 --codec=h264 --crf=16",
    "render:preview": "remotion render BeyondPossibilities out/preview-1080p.mp4 --scale=0.5 --crf=22",
    "still": "remotion still BeyondPossibilities out/still.png --scale=0.5",
    "stills": "node scripts/stills.mjs out/stills 120 420 760 1150 1500 1800 2120 2330",
    "typecheck": "tsc --noEmit",
    "build:web": "esbuild web/App.tsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --define:process.env.NODE_ENV='\"production\"' --outfile=web/dist/app.js"
  },
  "dependencies": {
    "@remotion/cli": "4.0.546",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@remotion/player": "^4.0.546",
    "@types/react": "18.3.12",
    "esbuild": "^0.24.0",
    "typescript": "5.6.3"
  }
}
